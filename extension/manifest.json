{
  "manifest_version": 3,
  "name": "StreamCatch \u2014 Universal Video Downloader",
  "short_name": "StreamCatch",
  "version": "1.2.1",
  "author": "Soahim Rahman Tasin",
  "description": "Download permitted videos, playlists and bulk URL batches with format controls and a persistent side panel.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "webRequest",
    "sidePanel",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8735/*",
    "https://raw.githubusercontent.com/soahimrahman/StreamCatch/*",
    "https://api.github.com/repos/soahimrahman/StreamCatch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamCatch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116"
}